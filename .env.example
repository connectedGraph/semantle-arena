# 环境变量（复制为 .env 后按需修改，.env 不入库）

# ---------- LLM（Agent 用） ----------
# 默认走本机网关 work2api；也可指向 DeepSeek 官方：
#   ARENA_LLM_BASE_URL=https://api.deepseek.com/v1
#   ARENA_LLM_API_KEY=sk-...
#   ARENA_LLM_MODEL=deepseek-chat
ARENA_LLM_BASE_URL=http://127.0.0.1:8787/v1
ARENA_LLM_API_KEY=sk-local
ARENA_LLM_MODEL=workbuddy/deepseek-v4.1-flash
ARENA_LLM_TEMPERATURE=0.7

# 若网关不通，可填本地代理（本机有 mihomo 时）
# ARENA_LLM_PROXY=http://127.0.0.1:7890

# ---------- 词库档位 ----------
# small(3000 日常具象词) / medium(8000) / full(1.6 万)。
# 运行中也能通过 UI 顶部切换（POST /api/tier）。
ARENA_TIER=small

# ---------- 服务 ----------
ARENA_PORT=8010
ARENA_LOG_LEVEL=INFO
